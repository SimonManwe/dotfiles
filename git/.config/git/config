[core]
pager = delta

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[init]
	defaultBranch = main

[pull]
	# No unwanted merge commits from `git pull`
	rebase = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[merge]
	conflictStyle = zdiff3

[rerere]
	# remember conflict resolutions and replay them
	enabled = true

[diff]
	algorithm = histogram
	colorMoved = default

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[branch]
	sort = -committerdate

[commit]
	verbose = true

[url "git@github.com:"]
	insteadOf = https://github.com/
