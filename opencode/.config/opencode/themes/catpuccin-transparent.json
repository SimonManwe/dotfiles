{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "rosewater": "#f2d5cf",
    "flamingo": "#eebebe",
    "pink": "#f4b8e4",
    "mauve": "#ca9ee6",
    "red": "#e78284",
    "maroon": "#ea999c",
    "peach": "#ef9f76",
    "yellow": "#e5c890",
    "green": "#a6d189",
    "teal": "#81c8be",
    "sky": "#99d1db",
    "sapphire": "#85c1dc",
    "blue": "#8caaee",
    "lavender": "#babbf1",
    "text": "#c6d0f5",
    "subtext1": "#b5bfe2",
    "subtext0": "#a5adce",
    "overlay2": "#949cbb",
    "overlay1": "#838ba7",
    "overlay0": "#737994",
    "surface2": "#626880",
    "surface1": "#51576d",
    "surface0": "#414559",
    "base": "#303446",
    "mantle": "#292c3c",
    "crust": "#232634"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "lavender", "light": "lavender" },
    "accent": { "dark": "mauve", "light": "mauve" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "peach", "light": "peach" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "sky", "light": "sky" },

    "text": { "dark": "text", "light": "text" },
    "textMuted": { "dark": "subtext0", "light": "subtext0" },

    "background": { "dark": "none", "light": "none" },
    "backgroundPanel": { "dark": "none", "light": "none" },
    "backgroundElement": { "dark": "surface0", "light": "surface0" },

    "border": { "dark": "surface1", "light": "surface1" },
    "borderActive": { "dark": "surface2", "light": "surface2" },
    "borderSubtle": { "dark": "surface0", "light": "surface0" },

    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "overlay0", "light": "overlay0" },
    "diffHunkHeader": { "dark": "overlay0", "light": "overlay0" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#3d4a3d", "light": "#3d4a3d" },
    "diffRemovedBg": { "dark": "#4a3d3d", "light": "#4a3d3d" },
    "diffContextBg": { "dark": "none", "light": "none" },
    "diffLineNumber": { "dark": "surface1", "light": "surface1" },
    "diffAddedLineNumberBg": { "dark": "#3d4a3d", "light": "#3d4a3d" },
    "diffRemovedLineNumberBg": { "dark": "#4a3d3d", "light": "#4a3d3d" },

    "markdownText": { "dark": "text", "light": "text" },
    "markdownHeading": { "dark": "blue", "light": "blue" },
    "markdownLink": { "dark": "lavender", "light": "lavender" },
    "markdownLinkText": { "dark": "mauve", "light": "mauve" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "overlay0", "light": "overlay0" },
    "markdownEmph": { "dark": "peach", "light": "peach" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "overlay0", "light": "overlay0" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "mauve", "light": "mauve" },
    "markdownImage": { "dark": "lavender", "light": "lavender" },
    "markdownImageText": { "dark": "mauve", "light": "mauve" },
    "markdownCodeBlock": { "dark": "text", "light": "text" },

    "syntaxComment": { "dark": "overlay0", "light": "overlay0" },
    "syntaxKeyword": { "dark": "mauve", "light": "mauve" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "text", "light": "text" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "peach", "light": "peach" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "sky", "light": "sky" },
    "syntaxPunctuation": { "dark": "overlay2", "light": "overlay2" }
  }
}
