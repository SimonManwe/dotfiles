# Terminal styling
background-opacity = 0.8
theme = custom-dark-theme
window-decoration = false

# Fonts
font-size = 12.5
font-family = FiraCode Nerd Font
font-feature = +calt
font-feature = +liga

# Shell
command = /usr/bin/zsh -lc 'tmux new-session -A -s main || exec zsh'

# ssh
shell-integration-features = ssh-env,ssh-terminfo

# URL settings
link-url = true

# Mouse settings
mouse-hide-while-typing = true

# close Terminal windows without confirmation
confirm-close-surface = false

# Scrollback-limit == 10MB per default
